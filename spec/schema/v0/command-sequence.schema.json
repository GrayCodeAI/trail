{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.graycodeai.com/trail/0.1-draft/command-sequence.schema.json",
  "title": "Trail Protocol v0 portable command-sequence fixture",
  "type": "object",
  "required": ["specVersion", "home", "eventIdPrefix", "clock", "policy", "cases"],
  "properties": {
    "specVersion": { "const": "graycode.trail/0.1-draft" },
    "home": { "$ref": "common.schema.json#/$defs/id" },
    "eventIdPrefix": { "$ref": "common.schema.json#/$defs/id" },
    "clock": { "$ref": "common.schema.json#/$defs/timestamp" },
    "policy": {
      "type": "object",
      "required": ["id", "version", "allow"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["workspace", "principal", "actions"],
            "properties": {
              "workspace": { "$ref": "common.schema.json#/$defs/id" },
              "principal": { "$ref": "common.schema.json#/$defs/principalId" },
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["command", "expected"],
              "properties": {
                "command": { "$ref": "command.schema.json" },
                "expected": {
                  "type": "object",
                  "required": ["class"],
                  "properties": {
                    "class": { "enum": ["accepted", "conflict", "denied", "invalid", "deferred", "unavailable"] },
                    "code": { "type": "string" },
                    "eventType": { "type": "string", "pattern": "^trail\\." },
                    "sameEventAsStep": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
