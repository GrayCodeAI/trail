{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.graycodeai.com/trail/0.1-draft/command.schema.json",
  "title": "Trail Protocol v0 executable command profile",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/commandEnvelope" },
    {
      "oneOf": [
        {
          "properties": {
            "type": { "const": "trail.outcome.create" },
            "payload": { "$ref": "#/$defs/outcomeDefinition" }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.outcome.amend" },
            "payload": { "$ref": "#/$defs/outcomeDefinition" }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.acceptance.accept" },
            "payload": {
              "type": "object",
              "required": ["acceptanceId", "evidenceIds"],
              "properties": {
                "acceptanceId": { "$ref": "common.schema.json#/$defs/id" },
                "evidenceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common.schema.json#/$defs/id" }
                }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.commitment.propose" },
            "payload": {
              "type": "object",
              "required": ["debtor", "creditor", "antecedent", "consequent", "outcomeId", "deadline", "acceptancePolicy"],
              "properties": {
                "debtor": { "$ref": "common.schema.json#/$defs/principalId" },
                "creditor": { "$ref": "common.schema.json#/$defs/principalId" },
                "antecedent": { "type": "string", "minLength": 1 },
                "consequent": { "type": "string", "minLength": 1 },
                "outcomeId": { "$ref": "common.schema.json#/$defs/id" },
                "deadline": { "$ref": "common.schema.json#/$defs/timestamp" },
                "acceptancePolicy": { "$ref": "common.schema.json#/$defs/id" }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.commitment.accept" },
            "payload": {
              "type": "object",
              "required": ["termsVersion"],
              "properties": {
                "termsVersion": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.work.create" },
            "payload": {
              "type": "object",
              "required": ["plan", "exclusive", "purpose", "evidencePolicy"],
              "properties": {
                "outcomeId": { "$ref": "common.schema.json#/$defs/id" },
                "commitmentId": { "$ref": "common.schema.json#/$defs/id" },
                "plan": { "type": "string", "minLength": 1 },
                "exclusive": { "type": "boolean" },
                "purpose": { "type": "string", "minLength": 1 },
                "evidencePolicy": { "$ref": "common.schema.json#/$defs/id" }
              },
              "anyOf": [
                { "required": ["outcomeId"] },
                { "required": ["commitmentId"] }
              ],
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.grant.issue" },
            "payload": {
              "type": "object",
              "required": ["subject", "actions", "resource", "purpose", "notBefore", "expiresAt"],
              "properties": {
                "subject": { "$ref": "common.schema.json#/$defs/principalId" },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "resource": { "$ref": "common.schema.json#/$defs/id" },
                "purpose": { "type": "string", "minLength": 1 },
                "notBefore": { "$ref": "common.schema.json#/$defs/timestamp" },
                "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.grant.revoke" },
            "payload": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.claim.acquire" },
            "payload": {
              "type": "object",
              "required": ["workId", "holder", "expiresAt"],
              "properties": {
                "workId": { "$ref": "common.schema.json#/$defs/id" },
                "holder": { "$ref": "common.schema.json#/$defs/principalId" },
                "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.claim.release" },
            "payload": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.run.request" },
            "payload": {
              "type": "object",
              "required": ["workId", "workVersion", "executor", "operator", "workload", "delegation", "leaseId", "fencingToken", "grantIds", "budget", "deadline", "checkpointPolicy", "environment", "evidencePolicy", "sideEffectStrategy"],
              "properties": {
                "workId": { "$ref": "common.schema.json#/$defs/id" },
                "workVersion": { "type": "integer", "minimum": 1 },
                "executor": { "$ref": "common.schema.json#/$defs/principalId" },
                "operator": { "$ref": "common.schema.json#/$defs/principalId" },
                "workload": { "$ref": "common.schema.json#/$defs/principalId" },
                "delegation": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "$ref": "common.schema.json#/$defs/principalId" }
                },
                "leaseId": { "$ref": "common.schema.json#/$defs/id" },
                "fencingToken": { "type": "integer", "minimum": 1 },
                "grantIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "common.schema.json#/$defs/id" }
                },
                "budget": { "$ref": "resources.schema.json#/$defs/budgetLimit" },
                "deadline": { "$ref": "common.schema.json#/$defs/timestamp" },
                "checkpointPolicy": { "type": "string", "minLength": 1 },
                "environment": { "type": "string", "minLength": 1 },
                "evidencePolicy": { "$ref": "common.schema.json#/$defs/id" },
                "sideEffectStrategy": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.run.report-result" },
            "payload": {
              "type": "object",
              "required": ["summary"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        {
          "properties": {
            "type": { "const": "trail.evidence.submit" },
            "payload": {
              "type": "object",
              "required": ["outcomeId", "outcomeVersion", "criterionId", "sourceRunId", "sourceRunVersion", "method", "result", "evaluator", "evaluatorAccountable", "artifacts", "validFrom", "validUntil", "limitations"],
              "properties": {
                "outcomeId": { "$ref": "common.schema.json#/$defs/id" },
                "outcomeVersion": { "type": "integer", "minimum": 1 },
                "criterionId": { "$ref": "common.schema.json#/$defs/id" },
                "sourceRunId": { "$ref": "common.schema.json#/$defs/id" },
                "sourceRunVersion": { "type": "integer", "minimum": 1 },
                "method": { "type": "string", "minLength": 1 },
                "result": { "enum": ["pass", "fail", "inconclusive"] },
                "evaluator": { "$ref": "common.schema.json#/$defs/principalId" },
                "evaluatorAccountable": { "$ref": "common.schema.json#/$defs/principalId" },
                "artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "resources.schema.json#/$defs/artifact" }
                },
                "validFrom": { "$ref": "common.schema.json#/$defs/timestamp" },
                "validUntil": { "$ref": "common.schema.json#/$defs/timestamp" },
                "limitations": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "outcomeDefinition": {
      "type": "object",
      "required": ["desiredCondition", "steward", "scope", "horizon", "criteria"],
      "properties": {
        "desiredCondition": { "type": "string", "minLength": 1 },
        "steward": { "$ref": "common.schema.json#/$defs/principalId" },
        "scope": { "type": "string", "minLength": 1 },
        "horizon": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "resources.schema.json#/$defs/criterion" }
        }
      },
      "additionalProperties": true
    }
  }
}
